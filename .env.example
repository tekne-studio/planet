# Copy to .env. Bun loads it for every script in scripts/.

# Alone, every session has this level: anonymous, signed_in,
# builder or admin. Unset, `bun run dev` and `bun run server` say admin, so
# the one at the keyboard founds the world and builds.
# PLANET_DEV_LEVEL=admin

# Where the world keeps itself. Unset, server/world.
# WORLD_DIR=

# The asset set, whose fields/ the server shapes a field's world with. Unset,
# `bun run dev` and `bun run server` take the repo's assets/, and the image
# its WEB_DIR/assets.
# ASSETS_DIR=

# The port the server listens on. Unset, `bun run server` uses 8090 and
# `bun run dev` starts at 8190, taking the next free one when it is held;
# `bun run web` alone follows a server elsewhere through WORLD_ORIGIN.
# PORT=
# WORLD_ORIGIN=

# Under mundos these three come together and stand in place of the level
# above: the key that checks its tokens (PEM, newlines escaped), its origin,
# and the world's name there.
# MUNDOS_PUBLIC_KEY=
# PUBLIC_MUNDOS_URL=
# PUBLIC_MUNDOS_WORLD=
